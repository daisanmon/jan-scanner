{
  "name": "jan-scanner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "typecheck": "tsc -b && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:frontend": "tsc -b && vite build",
    "build:worker": "tsc -p tsconfig.worker.json && wrangler deploy --dry-run --outdir dist-worker",
    "build": "npm run build:frontend && npm run build:worker",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy:worker": "npm run typecheck && npm run test && npm run lint && wrangler deploy"
  },
  "dependencies": {
    "@ericblade/quagga2": "^1.12.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
